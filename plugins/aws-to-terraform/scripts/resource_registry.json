{
  "version": "1.0.0",
  "description": "AWS リソース → Terraform リソース マッピング定義",
  "resources": [
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "vpc",
      "tf_resource_type": "aws_vpc",
      "list_command": "aws ec2 describe-vpcs --query 'Vpcs[?!IsDefault]'",
      "id_jq": ".VpcId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .VpcId",
      "import_id_template": "{VpcId}",
      "import_id_example": "vpc-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["CidrBlock", "EnableDnsHostnames", "EnableDnsSupport", "InstanceTenancy", "Tags"],
      "skip_if": "IsDefault == true"
    },
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "subnet",
      "tf_resource_type": "aws_subnet",
      "list_command": "aws ec2 describe-subnets --query 'Subnets[?!DefaultForAz]'",
      "id_jq": ".SubnetId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .SubnetId",
      "import_id_template": "{SubnetId}",
      "import_id_example": "subnet-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["VpcId", "CidrBlock", "AvailabilityZone", "MapPublicIpOnLaunch", "Tags"],
      "depends_on": ["aws_vpc"]
    },
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "internet-gateway",
      "tf_resource_type": "aws_internet_gateway",
      "list_command": "aws ec2 describe-internet-gateways --query 'InternetGateways'",
      "id_jq": ".InternetGatewayId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .InternetGatewayId",
      "import_id_template": "{InternetGatewayId}",
      "import_id_example": "igw-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["Attachments", "Tags"],
      "depends_on": ["aws_vpc"]
    },
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "nat-gateway",
      "tf_resource_type": "aws_nat_gateway",
      "list_command": "aws ec2 describe-nat-gateways --query 'NatGateways[?State==`available`]'",
      "id_jq": ".NatGatewayId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .NatGatewayId",
      "import_id_template": "{NatGatewayId}",
      "import_id_example": "nat-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["SubnetId", "AllocationId", "ConnectivityType", "Tags"],
      "depends_on": ["aws_subnet", "aws_eip"]
    },
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "eip",
      "tf_resource_type": "aws_eip",
      "list_command": "aws ec2 describe-addresses --query 'Addresses'",
      "id_jq": ".AllocationId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .AllocationId",
      "import_id_template": "{AllocationId}",
      "import_id_example": "eipalloc-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["Domain", "Tags"]
    },
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "route-table",
      "tf_resource_type": "aws_route_table",
      "list_command": "aws ec2 describe-route-tables --query 'RouteTables[?Associations[0].Main!=`true`]'",
      "id_jq": ".RouteTableId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .RouteTableId",
      "import_id_template": "{RouteTableId}",
      "import_id_example": "rtb-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["VpcId", "Routes", "Tags"],
      "depends_on": ["aws_vpc", "aws_internet_gateway", "aws_nat_gateway"],
      "note": "Route Table Associationは別途 aws_route_table_association として import"
    },
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "security-group",
      "tf_resource_type": "aws_security_group",
      "list_command": "aws ec2 describe-security-groups --query 'SecurityGroups[?GroupName!=`default`]'",
      "id_jq": ".GroupId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .GroupName",
      "import_id_template": "{GroupId}",
      "import_id_example": "sg-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["GroupName", "Description", "VpcId", "IpPermissions", "IpPermissionsEgress", "Tags"],
      "depends_on": ["aws_vpc"]
    },
    {
      "category": "networking",
      "aws_service": "ec2",
      "aws_resource_type": "vpc-endpoint",
      "tf_resource_type": "aws_vpc_endpoint",
      "list_command": "aws ec2 describe-vpc-endpoints --query 'VpcEndpoints[?State==`available`]'",
      "id_jq": ".VpcEndpointId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .VpcEndpointId",
      "import_id_template": "{VpcEndpointId}",
      "import_id_example": "vpce-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["VpcId", "ServiceName", "VpcEndpointType", "SubnetIds", "SecurityGroupIds", "Tags"]
    },
    {
      "category": "compute",
      "aws_service": "ec2",
      "aws_resource_type": "instance",
      "tf_resource_type": "aws_instance",
      "list_command": "aws ec2 describe-instances --query 'Reservations[*].Instances[?State.Name!=`terminated`]' | jq 'flatten(1)'",
      "id_jq": ".InstanceId",
      "name_jq": "(.Tags // [] | map(select(.Key == \"Name\")) | first | .Value) // .InstanceId",
      "import_id_template": "{InstanceId}",
      "import_id_example": "i-0123456789abcdef0",
      "is_global": false,
      "key_attributes": ["ImageId", "InstanceType", "KeyName", "SubnetId", "VpcId", "SecurityGroups", "IamInstanceProfile", "Tags"],
      "depends_on": ["aws_subnet", "aws_security_group", "aws_key_pair", "aws_iam_instance_profile"]
    },
    {
      "category": "compute",
      "aws_service": "ec2",
      "aws_resource_type": "key-pair",
      "tf_resource_type": "aws_key_pair",
      "list_command": "aws ec2 describe-key-pairs --query 'KeyPairs'",
      "id_jq": ".KeyName",
      "name_jq": ".KeyName",
      "import_id_template": "{KeyName}",
      "import_id_example": "my-key-pair",
      "is_global": false,
      "key_attributes": ["KeyName", "Tags"],
      "note": "公開鍵情報はimport後に terraform state show で確認できる"
    },
    {
      "category": "compute",
      "aws_service": "autoscaling",
      "aws_resource_type": "auto-scaling-group",
      "tf_resource_type": "aws_autoscaling_group",
      "list_command": "aws autoscaling describe-auto-scaling-groups --query 'AutoScalingGroups'",
      "id_jq": ".AutoScalingGroupName",
      "name_jq": ".AutoScalingGroupName",
      "import_id_template": "{AutoScalingGroupName}",
      "import_id_example": "my-asg",
      "is_global": false,
      "key_attributes": ["AutoScalingGroupName", "MinSize", "MaxSize", "DesiredCapacity", "VPCZoneIdentifier", "TargetGroupARNs", "Tags"]
    },
    {
      "category": "storage",
      "aws_service": "s3",
      "aws_resource_type": "bucket",
      "tf_resource_type": "aws_s3_bucket",
      "list_command": "aws s3api list-buckets --query 'Buckets'",
      "id_jq": ".Name",
      "name_jq": ".Name | gsub(\"-\"; \"_\") | gsub(\"\\\\.\"; \"_\")",
      "import_id_template": "{BucketName}",
      "import_id_example": "my-bucket-name",
      "is_global": true,
      "region_check_command": "aws s3api get-bucket-location --bucket {BucketName}",
      "key_attributes": ["Name"],
      "note": "バージョニング、ACL、ポリシー等は別リソースとして追加で import が必要"
    },
    {
      "category": "database",
      "aws_service": "rds",
      "aws_resource_type": "db-instance",
      "tf_resource_type": "aws_db_instance",
      "list_command": "aws rds describe-db-instances --query 'DBInstances'",
      "id_jq": ".DBInstanceIdentifier",
      "name_jq": ".DBInstanceIdentifier | gsub(\"-\"; \"_\")",
      "import_id_template": "{DBInstanceIdentifier}",
      "import_id_example": "my-db-instance",
      "is_global": false,
      "key_attributes": ["DBInstanceIdentifier", "DBInstanceClass", "Engine", "EngineVersion", "AllocatedStorage", "DBSubnetGroup", "VpcSecurityGroups", "Tags"],
      "depends_on": ["aws_db_subnet_group", "aws_db_parameter_group", "aws_security_group"]
    },
    {
      "category": "database",
      "aws_service": "rds",
      "aws_resource_type": "db-subnet-group",
      "tf_resource_type": "aws_db_subnet_group",
      "list_command": "aws rds describe-db-subnet-groups --query 'DBSubnetGroups[?DBSubnetGroupName!=`default`]'",
      "id_jq": ".DBSubnetGroupName",
      "name_jq": ".DBSubnetGroupName | gsub(\"-\"; \"_\")",
      "import_id_template": "{DBSubnetGroupName}",
      "import_id_example": "my-db-subnet-group",
      "is_global": false,
      "key_attributes": ["DBSubnetGroupName", "DBSubnetGroupDescription", "SubnetIds", "Tags"]
    },
    {
      "category": "database",
      "aws_service": "dynamodb",
      "aws_resource_type": "table",
      "tf_resource_type": "aws_dynamodb_table",
      "list_command": "aws dynamodb list-tables --query 'TableNames'",
      "id_jq": ".",
      "name_jq": ". | gsub(\"-\"; \"_\")",
      "import_id_template": "{TableName}",
      "import_id_example": "my-table",
      "is_global": false,
      "detail_command": "aws dynamodb describe-table --table-name {TableName}"
    },
    {
      "category": "iam",
      "aws_service": "iam",
      "aws_resource_type": "role",
      "tf_resource_type": "aws_iam_role",
      "list_command": "aws iam list-roles --query 'Roles[?!contains(Path, `/aws-service-role/`) && !contains(RoleName, `AWSServiceRole`)]'",
      "id_jq": ".RoleName",
      "name_jq": ".RoleName | gsub(\"-\"; \"_\")",
      "import_id_template": "{RoleName}",
      "import_id_example": "my-iam-role",
      "is_global": true,
      "key_attributes": ["RoleName", "AssumeRolePolicyDocument", "Description", "MaxSessionDuration", "Tags"]
    },
    {
      "category": "iam",
      "aws_service": "iam",
      "aws_resource_type": "policy",
      "tf_resource_type": "aws_iam_policy",
      "list_command": "aws iam list-policies --scope Local --query 'Policies'",
      "id_jq": ".Arn",
      "name_jq": ".PolicyName | gsub(\"-\"; \"_\")",
      "import_id_template": "{Arn}",
      "import_id_example": "arn:aws:iam::123456789012:policy/my-policy",
      "is_global": true,
      "key_attributes": ["PolicyName", "PolicyDocument", "Description", "Tags"],
      "note": "AWSマネージドポリシー（arn:aws:iam::aws:policy/*）は除外"
    },
    {
      "category": "iam",
      "aws_service": "iam",
      "aws_resource_type": "instance-profile",
      "tf_resource_type": "aws_iam_instance_profile",
      "list_command": "aws iam list-instance-profiles --query 'InstanceProfiles'",
      "id_jq": ".InstanceProfileName",
      "name_jq": ".InstanceProfileName | gsub(\"-\"; \"_\")",
      "import_id_template": "{InstanceProfileName}",
      "import_id_example": "my-instance-profile",
      "is_global": true
    },
    {
      "category": "load_balancing",
      "aws_service": "elbv2",
      "aws_resource_type": "load-balancer",
      "tf_resource_type": "aws_lb",
      "list_command": "aws elbv2 describe-load-balancers --query 'LoadBalancers'",
      "id_jq": ".LoadBalancerArn",
      "name_jq": ".LoadBalancerName | gsub(\"-\"; \"_\")",
      "import_id_template": "{LoadBalancerArn}",
      "import_id_example": "arn:aws:elasticloadbalancing:ap-northeast-1:123456789012:loadbalancer/app/my-alb/1234567890abcdef",
      "is_global": false,
      "key_attributes": ["LoadBalancerName", "Scheme", "Type", "IpAddressType", "SubnetMappings", "SecurityGroups", "Tags"]
    },
    {
      "category": "load_balancing",
      "aws_service": "elbv2",
      "aws_resource_type": "target-group",
      "tf_resource_type": "aws_lb_target_group",
      "list_command": "aws elbv2 describe-target-groups --query 'TargetGroups'",
      "id_jq": ".TargetGroupArn",
      "name_jq": ".TargetGroupName | gsub(\"-\"; \"_\")",
      "import_id_template": "{TargetGroupArn}",
      "import_id_example": "arn:aws:elasticloadbalancing:ap-northeast-1:123456789012:targetgroup/my-tg/1234567890abcdef",
      "is_global": false,
      "key_attributes": ["TargetGroupName", "Protocol", "Port", "VpcId", "TargetType", "HealthCheckProtocol", "HealthCheckPath", "Tags"]
    },
    {
      "category": "load_balancing",
      "aws_service": "elbv2",
      "aws_resource_type": "listener",
      "tf_resource_type": "aws_lb_listener",
      "list_command": "elbv2 describe-listeners (ALB ARNごとに実行)",
      "id_jq": ".ListenerArn",
      "name_jq": "\"listener_\" + (.Protocol | ascii_downcase) + \"_\" + (.Port | tostring)",
      "import_id_template": "{ListenerArn}",
      "import_id_example": "arn:aws:elasticloadbalancing:ap-northeast-1:123456789012:listener/app/my-alb/1234567890abcdef/abcdef1234567890",
      "is_global": false,
      "depends_on": ["aws_lb", "aws_lb_target_group"]
    },
    {
      "category": "serverless",
      "aws_service": "lambda",
      "aws_resource_type": "function",
      "tf_resource_type": "aws_lambda_function",
      "list_command": "aws lambda list-functions --query 'Functions'",
      "id_jq": ".FunctionName",
      "name_jq": ".FunctionName | gsub(\"-\"; \"_\")",
      "import_id_template": "{FunctionName}",
      "import_id_example": "my-lambda-function",
      "is_global": false,
      "key_attributes": ["FunctionName", "Runtime", "Handler", "Role", "MemorySize", "Timeout", "Environment", "Tags"]
    },
    {
      "category": "serverless",
      "aws_service": "sqs",
      "aws_resource_type": "queue",
      "tf_resource_type": "aws_sqs_queue",
      "list_command": "aws sqs list-queues --query 'QueueUrls'",
      "id_jq": ".",
      "name_jq": "split(\"/\") | last | gsub(\"-\"; \"_\")",
      "import_id_template": "{QueueUrl}",
      "import_id_example": "https://sqs.ap-northeast-1.amazonaws.com/123456789012/my-queue",
      "is_global": false
    },
    {
      "category": "serverless",
      "aws_service": "sns",
      "aws_resource_type": "topic",
      "tf_resource_type": "aws_sns_topic",
      "list_command": "aws sns list-topics --query 'Topics[*].TopicArn'",
      "id_jq": ".",
      "name_jq": "split(\":\") | last | gsub(\"-\"; \"_\")",
      "import_id_template": "{TopicArn}",
      "import_id_example": "arn:aws:sns:ap-northeast-1:123456789012:my-topic",
      "is_global": false
    },
    {
      "category": "container",
      "aws_service": "ecs",
      "aws_resource_type": "cluster",
      "tf_resource_type": "aws_ecs_cluster",
      "list_command": "aws ecs list-clusters --query 'clusterArns' | xargs -I{} aws ecs describe-clusters --clusters {} --query 'clusters'",
      "id_jq": ".clusterName",
      "name_jq": ".clusterName | gsub(\"-\"; \"_\")",
      "import_id_template": "{ClusterName}",
      "import_id_example": "my-ecs-cluster",
      "is_global": false,
      "key_attributes": ["clusterName", "settings", "tags"]
    },
    {
      "category": "container",
      "aws_service": "ecs",
      "aws_resource_type": "task-definition",
      "tf_resource_type": "aws_ecs_task_definition",
      "list_command": "aws ecs list-task-definitions --status ACTIVE --query 'taskDefinitionArns'",
      "id_jq": ".",
      "name_jq": "split(\"/\") | last | split(\":\") | first | gsub(\"-\"; \"_\")",
      "import_id_template": "{TaskDefinitionArn}",
      "import_id_example": "arn:aws:ecs:ap-northeast-1:123456789012:task-definition/my-task:5",
      "is_global": false,
      "note": "アクティブな最新リビジョンのみを対象とする"
    },
    {
      "category": "container",
      "aws_service": "ecs",
      "aws_resource_type": "service",
      "tf_resource_type": "aws_ecs_service",
      "list_command": "各クラスターに対して aws ecs list-services を実行",
      "id_jq": ".",
      "name_jq": "split(\"/\") | last | gsub(\"-\"; \"_\")",
      "import_id_template": "{ClusterName}/{ServiceName}",
      "import_id_example": "my-cluster/my-service",
      "is_global": false,
      "depends_on": ["aws_ecs_cluster", "aws_ecs_task_definition", "aws_lb_target_group"]
    },
    {
      "category": "dns",
      "aws_service": "route53",
      "aws_resource_type": "hosted-zone",
      "tf_resource_type": "aws_route53_zone",
      "list_command": "aws route53 list-hosted-zones --query 'HostedZones'",
      "id_jq": ".Id | split(\"/\") | last",
      "name_jq": ".Name | gsub(\"\\\\.\"; \"_\") | rtrimstr(\"_\")",
      "import_id_template": "{HostedZoneId}",
      "import_id_example": "Z1234567890ABCDEF",
      "is_global": true,
      "key_attributes": ["Name", "Config"]
    },
    {
      "category": "dns",
      "aws_service": "route53",
      "aws_resource_type": "record",
      "tf_resource_type": "aws_route53_record",
      "list_command": "各ホストゾーンに対して aws route53 list-resource-record-sets を実行",
      "id_jq": "null",
      "name_jq": "null",
      "import_id_template": "{HostedZoneId}_{RecordName}_{RecordType}",
      "import_id_example": "Z1234567890ABCDEF_example.com_A",
      "is_global": true,
      "depends_on": ["aws_route53_zone"],
      "note": "NS/SOAレコードは import するが Terraformで管理しないことが多い"
    },
    {
      "category": "cdn",
      "aws_service": "cloudfront",
      "aws_resource_type": "distribution",
      "tf_resource_type": "aws_cloudfront_distribution",
      "list_command": "aws cloudfront list-distributions --query 'DistributionList.Items'",
      "id_jq": ".Id",
      "name_jq": "(.Aliases.Items[0] // .Id) | gsub(\"\\\\.\"; \"_\") | gsub(\"-\"; \"_\")",
      "import_id_template": "{DistributionId}",
      "import_id_example": "E1ABCDEFGHIJKL",
      "is_global": true,
      "key_attributes": ["Origins", "DefaultCacheBehavior", "PriceClass", "Enabled", "Tags"]
    },
    {
      "category": "secrets",
      "aws_service": "secretsmanager",
      "aws_resource_type": "secret",
      "tf_resource_type": "aws_secretsmanager_secret",
      "list_command": "aws secretsmanager list-secrets --query 'SecretList'",
      "id_jq": ".ARN",
      "name_jq": ".Name | gsub(\"/\"; \"_\") | gsub(\"-\"; \"_\")",
      "import_id_template": "{SecretArn}",
      "import_id_example": "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:my-secret-AbCdEf",
      "is_global": false
    },
    {
      "category": "monitoring",
      "aws_service": "cloudwatch",
      "aws_resource_type": "log-group",
      "tf_resource_type": "aws_cloudwatch_log_group",
      "list_command": "aws logs describe-log-groups --query 'logGroups'",
      "id_jq": ".logGroupName",
      "name_jq": ".logGroupName | ltrimstr(\"/\") | gsub(\"/\"; \"_\") | gsub(\"-\"; \"_\")",
      "import_id_template": "{LogGroupName}",
      "import_id_example": "/aws/lambda/my-function",
      "is_global": false
    },
    {
      "category": "monitoring",
      "aws_service": "cloudwatch",
      "aws_resource_type": "alarm",
      "tf_resource_type": "aws_cloudwatch_metric_alarm",
      "list_command": "aws cloudwatch describe-alarms --query 'MetricAlarms'",
      "id_jq": ".AlarmName",
      "name_jq": ".AlarmName | gsub(\" \"; \"_\") | gsub(\"-\"; \"_\")",
      "import_id_template": "{AlarmName}",
      "import_id_example": "my-alarm",
      "is_global": false
    }
  ],
  "resource_order": [
    "aws_eip",
    "aws_vpc",
    "aws_internet_gateway",
    "aws_subnet",
    "aws_security_group",
    "aws_network_acl",
    "aws_nat_gateway",
    "aws_route_table",
    "aws_route_table_association",
    "aws_vpc_endpoint",
    "aws_key_pair",
    "aws_iam_role",
    "aws_iam_policy",
    "aws_iam_instance_profile",
    "aws_iam_role_policy_attachment",
    "aws_cloudwatch_log_group",
    "aws_db_subnet_group",
    "aws_db_parameter_group",
    "aws_db_instance",
    "aws_elasticache_subnet_group",
    "aws_elasticache_cluster",
    "aws_dynamodb_table",
    "aws_s3_bucket",
    "aws_s3_bucket_versioning",
    "aws_s3_bucket_policy",
    "aws_s3_bucket_server_side_encryption_configuration",
    "aws_lb",
    "aws_lb_target_group",
    "aws_lb_listener",
    "aws_lb_listener_rule",
    "aws_instance",
    "aws_autoscaling_group",
    "aws_lambda_function",
    "aws_sqs_queue",
    "aws_sns_topic",
    "aws_ecs_cluster",
    "aws_ecs_task_definition",
    "aws_ecs_service",
    "aws_route53_zone",
    "aws_route53_record",
    "aws_cloudfront_distribution",
    "aws_secretsmanager_secret",
    "aws_cloudwatch_metric_alarm"
  ],
  "skip_patterns": {
    "aws_vpc": "IsDefault == true",
    "aws_subnet": "DefaultForAz == true",
    "aws_security_group": "GroupName == \"default\"",
    "aws_iam_role": "Path contains \"/aws-service-role/\"",
    "aws_iam_policy": "ARN starts with \"arn:aws:iam::aws:policy/\""
  },
  "common_ignore_changes": {
    "aws_ecs_service": ["desired_count", "task_definition"],
    "aws_autoscaling_group": ["desired_capacity"],
    "aws_instance": ["user_data", "user_data_base64"],
    "aws_db_instance": ["password", "snapshot_identifier"],
    "aws_lambda_function": ["last_modified", "source_code_hash"]
  }
}
